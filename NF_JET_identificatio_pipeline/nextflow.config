includeConfig 'conf/base.config'

workDir = '/GB/faramir/neondisco-jet/nf_work_v2'

process.executor = 'local'

profiles {
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.runOptions = '--bind /GB:/GB,/home/faramir:/home/faramir'
    }

    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.runOptions = '--bind /GB:/GB,/home/faramir:/home/faramir'
    }
}
