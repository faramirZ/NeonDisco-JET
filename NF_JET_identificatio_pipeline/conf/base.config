params {
    manifestPath = null
    outputDir = "${launchDir}/outputs"

    // Container images: check these filenames on your server.
    container__preproc = '/home/faramir/images/preproc.sif'
    container__pvactools = '/home/faramir/images/pVACtools.sif'
    container__jet_r = '/home/faramir/images/jet-r-4.5.3.sif'

    // STAR references.
    starIndexesDir = '/home/faramir/data/neondisco-jet/starIndexes_2.7.11b'
    starIndex = null
    starIndexName = 'star_index'
    sjdbOverhang = 100
    genomeFa = null
    gtf = null

    // JET identification references.
    repeatsFile = null
    jetRScript = "${projectDir}/bin/JET_analysis_filtered.R"
    genome = 'hg38'
}

process {
    withLabel: buildStarIndex {
        cpus = 16
        memory = '48 GB'
    }

    withLabel: alignReadsStar {
        cpus = 16
        memory = '48 GB'
    }

    withLabel: identifyJets {
        cpus = 1
        memory = '32 GB'
    }

    withLabel: predictPvacbind {
        cpus = 4
        memory = '16 GB'
    }
}

report {
    enabled = true
    file = "${params.outputDir}/reports/execution_report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.outputDir}/reports/timeline.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outputDir}/reports/trace.txt"
    overwrite = true
}
