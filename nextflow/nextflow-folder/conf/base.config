/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    JET Identification Pipeline (simplified: QC + trim + STAR align) Base Configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    help = false

    // Run options
    numCores = 8
    deleteIntermediateFiles = false

    // Input and output directories and manifest file
    manifestPath = false
    outputDir    = "./outputs"

    // Containers (local .sif images)
    container__preproc = "/home/faramir/images/preproc.sif"   // fastp + STAR + samtools
    container__qc      = "/home/faramir/images/kallisto.sif"   // FastQC (only image with it)

    // STAR index: searched in starIndexesDir (and its subfolders); built if none found
    starIndexesDir = "/home/faramir/data/neondisco-jet/starIndexes_2.7.11b"
    starIndex      = null          // optional: point directly at one specific index folder
    starIndexName  = "star_index"  // folder name used when a new index has to be built
    sjdbOverhang   = 100           // read length - 1 (only used when building with a GTF)

    // Only needed when no STAR index exists yet
    genomeFa = null                // genome FASTA (.fa or .fa.gz)
    gtf      = null                // annotation GTF (optional but recommended)
}

// Process resource defaults
process {
    cpus = params.numCores

    withLabel: 'qcReadsFastQC' {
        cpus   = 2
        memory = '4 GB'
    }

    withLabel: 'trimReads' {
        cpus   = 4
        memory = '8 GB'
    }

    withLabel: 'buildStarIndex' {
        cpus   = 16
        memory = '48 GB'
    }

    withLabel: 'alignReadsStar' {
        cpus   = 16
        memory = '48 GB'
    }
}

// Manifest settings
manifest {
    name            = 'JET-Identification-Pipeline (simplified)'
    description     = 'QC, trimming, and STAR alignment subset of the JET identification pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}

// Reporting
report {
    enabled = true
    file    = "${params.outputDir}/reports/execution_report.html"
}

timeline {
    enabled = true
    file    = "${params.outputDir}/reports/timeline.html"
}

trace {
    enabled = true
    file    = "${params.outputDir}/reports/trace.txt"
}

dag {
    enabled = true
    file    = "${params.outputDir}/reports/pipeline_dag.html"
}
