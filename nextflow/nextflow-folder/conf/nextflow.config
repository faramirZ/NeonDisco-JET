/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    JET Identification Pipeline (simplified: QC + trim + STAR align) Nextflow config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Local-only execution using singularity .sif images — no S3 / cloud involved
----------------------------------------------------------------------------------------
*/

includeConfig 'base.config'

workDir = "/GB/faramir/neondisco-jet/nf_work"
dag.overwrite      = true
trace.overwrite = true
report.overwrite   = true
timeline.overwrite = true

singularity.enabled    = true
singularity.autoMounts = true
singularity.runOptions = '--bind /GB'

process {
    executor = 'local'
    // container paths come from base.config (container__preproc / container__star)
}
